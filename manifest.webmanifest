{
  "name": "할수있어",
  "short_name": "할수있어",
  "description": "매일 루틴과 할 일을 체크하고 매시 정각에 남은 일을 알려주는 앱",
  "id": "/candoit/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6fa",
  "theme_color": "#3056e0",
  "lang": "ko",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://taichen2k.github.io/candoit/manifest.webmanifest",
      "id": "https://taichen2k.github.io/candoit/"
    }
  ],
  "prefer_related_applications": false
}
